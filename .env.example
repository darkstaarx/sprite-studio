# Salin jadi .env. Semua optional — tanpa fail ni pun ViralCool jalan
# (provider LLM "local" + akaun token manual + platform "manual").

# --- server
PORT=8787
HOST=127.0.0.1
# Token ringkas kalau kau expose server ni keluar localhost (UI akan minta sekali)
# VIRALCOOL_TOKEN=rahsia-panjang-kau
# Jangan terbitkan apa-apa betul-betul, cuma pura-pura (untuk uji):
# VIRALCOOL_DRY=1

# --- OAuth Threads (developers.facebook.com -> produk "Threads API")
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# --- OAuth Meta (Facebook Page + Instagram Business)
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v21.0

# URL awam server ni, untuk redirect OAuth (guna ngrok/cloudflared kalau di laptop)
# PUBLIC_URL=http://localhost:8787

# Ping bila post platform "manual" sampai masanya (ntfy, Discord webhook, dll)
# VIRALCOOL_WEBHOOK=https://ntfy.sh/topik-kau
